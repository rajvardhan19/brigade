@@ -5,10 +5,18 @@ from app.models import Session
 from app.passwords import hash_password, validate_password, verify_password
 
 
+MAX_FAILED_LOGINS = 5
+LOCKOUT_SECONDS = 15 * 60
+
+
 class AuthError(Exception):
     pass
 
 
+class RateLimited(AuthError):
+    pass
+
+
 def register(store, email, password):
     if not email or "@" not in email:
         raise AuthError("invalid email")
@@ -22,9 +30,26 @@ def register(store, email, password):
 
 
 def login(store, email, password) -> str:
+    # Attempts are tracked per lowercased email whether or not an account exists,
+    # so the limiter does not reveal which emails are registered.
+    key = (email or "").lower()
+    now = clock.now()
+    attempts = store.login_attempts.get(key)
+    if attempts and attempts["locked_until"] is not None:
+        if now < attempts["locked_until"]:
+            raise RateLimited("too many attempts")
+        attempts = None
+        store.login_attempts.pop(key, None)  # lockout over: count starts again from zero
+
     user = store.get_user_by_email(email or "")
     if user is None or not verify_password(password or "", user.password_hash, user.salt):
+        attempts = store.login_attempts.setdefault(key, {"failures": 0, "locked_until": None})
+        attempts["failures"] += 1
+        if attempts["failures"] >= MAX_FAILED_LOGINS:
+            attempts["locked_until"] = now + LOCKOUT_SECONDS
         raise AuthError("invalid credentials")
+
+    store.login_attempts.pop(key, None)
     token = secrets.token_urlsafe(32)
     store.add_session(Session(token, user.id, clock.now()))
     return token
