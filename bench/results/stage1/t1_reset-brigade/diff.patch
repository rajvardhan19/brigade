@@ -9,6 +10,13 @@ class AuthError(Exception):
     pass
 
 
+RESET_TOKEN_TTL = 30 * 60  # seconds
+
+
+def _hash_reset_token(token):
+    return hashlib.sha256(token.encode()).hexdigest()
+
+
 def register(store, email, password):
     if not email or "@" not in email:
         raise AuthError("invalid email")
@@ -42,3 +50,38 @@ def require_user(store, token):
     if user is None:
         raise AuthError("not logged in")
     return user
+
+
+def request_password_reset(store, outbox, email):
+    """Email a reset token if the account exists. Silent either way."""
+    user = store.get_user_by_email(email)
+    if user is None:
+        return
+    store.invalidate_reset_tokens_for_user(user.id)
+    token = secrets.token_urlsafe(32)
+    now = clock.now()
+    store.add_reset_token(ResetToken(_hash_reset_token(token), user.id, now, now + RESET_TOKEN_TTL))
+    outbox.send(
+        user.email,
+        "Password reset",
+        f"Someone asked to reset the password for this account.\n"
+        f"If it was you, use this token within 30 minutes:\n"
+        f"token: {token}\n",
+    )
+
+
+def confirm_password_reset(store, token, new_password):
+    """Set a new password using a reset token. Raises AuthError("invalid token" | "weak password")."""
+    if not isinstance(token, str) or not token:
+        raise AuthError("invalid token")
+    reset = store.get_reset_token(_hash_reset_token(token))
+    if reset is None or reset.used or clock.now() >= reset.expires_at:
+        raise AuthError("invalid token")
+    user = store.get_user(reset.user_id)
+    if user is None:
+        raise AuthError("invalid token")
+    if validate_password(new_password):
+        raise AuthError("weak password")
+    user.password_hash, user.salt = hash_password(new_password)
+    store.invalidate_reset_tokens_for_user(user.id)
+    store.delete_sessions_for_user(user.id)
